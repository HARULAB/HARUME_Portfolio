---
import { Providers } from "@/components/Providers";
import "@/styles/global.css";
import { ViewTransitions } from 'astro:transitions';

interface Props {
	title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "");
const basePath = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "");
const isHomePage = currentPath === basePath;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="HARUME Portfolio 2026" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		{isHomePage && (
			<>
				<!-- Google tag (gtag.js) -->
				<script async src="https://www.googletagmanager.com/gtag/js?id=G-9EEB2DLQD8"></script>
				<script is:inline>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', 'G-9EEB2DLQD8');
				</script>
			</>
		)}

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
		
		<ViewTransitions />
	</head>
	<body class="antialiased min-h-screen">
		<slot />
	</body>
</html>
